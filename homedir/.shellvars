# Set vim as default editor (vi is the default otherwise)
export EDITOR="vim"
bindkey -v

#########################################################################
# Tool paths
#########################################################################
#export CLOJURE_HOME=/Applications/Dev/clojure
#export EC2_HOME=/Applications/Dev/ec2-api-tools-1.3-46266
#export JAVA_HOME=/usr/bin/java
#export GOPATH=/usr/local/bin
#export GROOVY_HOME=/usr/local/opt/groovy/libexec

#########################################################################
# Tool settings
#########################################################################
export FONTCONFIG_PATH=/opt/X11/lib/X11/fontconfig
export NVM_DIR=~/.nvm

# ZLIB paths (for compilers and pkg-config)
export LDFLAGS="${LDFLAGS} -L/usr/local/opt/zlib/lib"
export CPPFLAGS="${CPPFLAGS} -I/usr/local/opt/zlib/include"
export PKG_CONFIG_PATH="${PKG_CONFIG_PATH} /usr/local/opt/zlib/lib/pkgconfig"

## Rancher desktop with VZ config for testcontainers
export DOCKER_HOST=unix://$HOME/.rd/docker.sock
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
export TESTCONTAINERS_RYUK_DISABLED=true
export TESTCONTAINERS_HOST_OVERRIDE=$(rdctl shell ip a show vznat | awk '/inet / {sub("/.*",""); print $2}')

#newrelic preflight
export NR_AI_ENABLE_SUBAGENT_WATCHER=1
